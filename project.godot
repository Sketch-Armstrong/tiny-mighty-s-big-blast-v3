; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tiny Mighty's Big Blast 1 point 3"
config/tags=PackedStringArray("real_one")
run/main_scene="uid://bkjyvdxuebm0n"
config/features=PackedStringArray("26.2", "Forward Plus", "Redot")
boot_splash/use_filter=false
boot_splash/image="uid://5d1umrmt1uei"
config/icon="uid://b23pmm2rij8d0"
boot_splash/stretch_mode=0

[autoload]

ConfigFileHandler="res://Singletons/ConfigFileHandler.gd"
GlobalVariables="*res://global_variables.gd"
GlobalHighscoreHandler="*res://Singletons/GlobalHighscoreHandler.gd"
GlobalFocusBooleans="*res://GlobalFocusBooleans.gd"
InputConfigHandler="*res://InputConfigHandler.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="viewport"
window/snap/snap_2d_vertices_to_pixel=true
window/snap/snap_2d_transforms_to_pixel=true
window/webp_compression/compression_method=2
window/lossless_compression/force_png=false
window/canvas_textures/default_texture_filter=0

[editor_plugins]

enabled=PackedStringArray("res://addons/crt/plugin.cfg")

